						regulator-min-microvolt = <0x186a00>;
						regulator-max-microvolt = <0x1dc130>;
						regulator-initial-mode = <0x00>;
						channel-mux-selection = <0x37>;
						schematic-name = "L23M_SPARE";
						subsys-name = "Spare";
					};

					LDO24M {
						regulator-name = "S2MPG14_LDO24";
						regulator-min-microvolt = <0x186a00>;
						regulator-max-microvolt = <0x1dc130>;
						regulator-initial-mode = <0x00>;
						channel-mux-selection = <0x38>;
						schematic-name = "L24M_SPARE";
						subsys-name = "Spare";
					};

					LDO25M {
						regulator-name = "S2MPG14_LDO25";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-initial-mode = <0x03>;
						channel-mux-selection = <0x39>;
						schematic-name = "L25M_TSP_DVDD";
						subsys-name = "TS";
						phandle = <0x52>;
					};
				};

				odpm {
					chip-name = "S2MPG14";
					sample-rate-uhz = <0x7735940>;
					sample-rate-external-uhz = <0x1dcd650>;
					max-refresh-time-ms = <0x6ddd00>;

					channels {

						channel@0 {
							rail-name = "BUCK1M";
							channel_enabled;
						};

						channel@1 {
							rail-name = "BUCK2M";
							channel_enabled;
						};

						channel@2 {
							rail-name = "BUCK3M";
							channel_enabled;
						};

						channel@3 {
							rail-name = "BUCK4M";
							channel_enabled;
						};

						channel@4 {
							rail-name = "BUCK5M";
							channel_enabled;
						};

						channel@5 {
							rail-name = "BUCK6M";
							channel_enabled;
						};

						channel@6 {
							rail-name = "BUCK7M";
							channel_enabled;
						};

						channel@7 {
							rail-name = "BUCK8M";
							channel_enabled;
						};

						channel@8 {
							rail-name = "BUCK9M";
							channel_enabled;
						};

						channel@9 {
							rail-name = "VSEN_C1";
							channel_enabled;
						};

						channel@10 {
							rail-name = "VSEN_C2";
							channel_enabled;
						};

						channel@11 {
							rail-name = "VSEN_C3";
							channel_enabled;
						};
					};

					rails {
						use-regulators-as-rails;

						VSEN_C1 {
							external_rail;
							channel-en-index = <0x01>;
							channel-mux-selection = <0x5c>;
							shunt-res-uohms = <0x1388>;
							schematic-name = "VSYS_PWR_DISPLAY";
							subsys-name = "Display";
						};

						VSEN_C2 {
							external_rail;
							channel-en-index = <0x02>;
							channel-mux-selection = <0x5d>;
							shunt-res-uohms = <0x1388>;
							schematic-name = "VSYS_PWR_CAMERA";
							subsys-name = "Camera";
						};

						VSEN_C3 {
							external_rail;
							channel-en-index = <0x04>;
							channel-mux-selection = <0x5e>;
							shunt-res-uohms = <0x1388>;
							schematic-name = "VSYS_PWR_RFFE";
							subsys-name = "Cellular";
						};
					};
				};

				s2mpg14_gpio {
					gpio-controller;
					#gpio-cells = <0x02>;
					ngpios = <0x06>;
					gpio-ranges = <0x02 0x00 0x00 0x06>;
					phandle = <0x75>;
				};

				s2mpg14_pinctrl {
					phandle = <0x02>;
				};
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			s2mpg15mfd@0 {
				compatible = "samsung,s2mpg15mfd";
				acpm-ipc-channel = <0x02>;
				acpm-speedy-channel = <0x01>;
				s2mpg15,wakeup = "enabled";
				reg = <0x2f>;
				interrupts = <0x01 0x00 0x00 0x01 0x00 0x01>;
				interrupt-parent = <0xffffffff>;
				pinctrl-names = "default";
				gpios = <0xffffffff 0x00 0x00 0xffffffff 0x01 0x00>;
