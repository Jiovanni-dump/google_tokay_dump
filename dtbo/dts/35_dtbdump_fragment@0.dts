				odpm {
					chip-name = "S2MPG15";
					sample-rate-uhz = <0x7735940>;
					sample-rate-external-uhz = <0x1dcd650>;
					max-refresh-time-ms = <0x6ddd00>;

					channels {

						channel@0 {
							rail-name = "BUCK1S";
							channel_enabled;
						};

						channel@1 {
							rail-name = "BUCK2S";
							channel_enabled;
						};

						channel@2 {
							rail-name = "BUCK4S";
							channel_enabled;
						};

						channel@3 {
							rail-name = "BUCK5S";
							channel_enabled;
						};

						channel@4 {
							rail-name = "LDO22S";
							channel_enabled;
						};

						channel@5 {
							rail-name = "BUCK9S";
							channel_enabled;
						};

						channel@6 {
							rail-name = "LDO2S";
							channel_enabled;
						};

						channel@7 {
							rail-name = "BUCK3S";
							channel_enabled;
						};

						channel@8 {
							rail-name = "LDO21S";
							channel_enabled;
						};

						channel@9 {
							rail-name = "VSEN_C4";
							channel_enabled;
						};

						channel@10 {
							rail-name = "VSEN_C5";
							channel_enabled;
						};

						channel@11 {
							rail-name = "VSEN_C6";
							channel_enabled;
						};
					};

					rails {
						use-regulators-as-rails;

						VSEN_C4 {
							external_rail;
							channel-en-index = <0x01>;
							channel-mux-selection = <0x5c>;
							shunt-res-uohms = <0x1388>;
							schematic-name = "VSYS_PWR_MODEM";
							subsys-name = "MODEM";
