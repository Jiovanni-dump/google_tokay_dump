						channel-mux-selection = <0x30>;
						schematic-name = "L16M_PCIE0";
						subsys-name = "PCIE";
					};

					LDO17M {
						regulator-name = "S2MPG14_LDO17";
						regulator-min-microvolt = <0xaae60>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-initial-mode = <0x01>;
						channel-mux-selection = <0x31>;
						schematic-name = "L17M_VDD_CPUCL2_HD_M";
						subsys-name = "CPU(BIG)";
					};

					LDO18M {
						regulator-name = "S2MPG14_LDO18";
						regulator-min-microvolt = <0xb1008>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-initial-mode = <0x03>;
						channel-mux-selection = <0x32>;
						schematic-name = "L18M_PCIE0";
						subsys-name = "PCIE";
					};

					LDO19M {
						regulator-name = "S2MPG14_LDO19";
						regulator-min-microvolt = <0x2625a0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-initial-mode = <0x03>;
						channel-mux-selection = <0x33>;
						schematic-name = "L19M_EUSB2";
						subsys-name = "USB";
						phandle = <0x0d>;
					};

					LDO20M {
						regulator-name = "S2MPG14_LDO20";
						regulator-min-microvolt = <0x186a00>;
						regulator-max-microvolt = <0x1dc130>;
						regulator-always-on;
						regulator-initial-mode = <0x03>;
						channel-mux-selection = <0x34>;
						schematic-name = "L20M_DMIC1";
						subsys-name = "DMIC";
					};

					LDO21M {
						regulator-name = "S2MPG14_LDO21";
						regulator-min-microvolt = <0x2625a0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-always-on;
						regulator-initial-mode = <0x03>;
						channel-mux-selection = <0x35>;
						schematic-name = "L21M_GSC";
						subsys-name = "GSC";
					};

					LDO22M {
						regulator-name = "S2MPG14_LDO22";
						regulator-min-microvolt = <0xb1008>;
						regulator-max-microvolt = <0x13d620>;
						regulator-initial-mode = <0x00>;
						channel-mux-selection = <0x36>;
						schematic-name = "L22M_SPARE";
						subsys-name = "Spare";
					};

					LDO23M {
