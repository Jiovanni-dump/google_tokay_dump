						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-initial-mode = <0x01>;
						channel-mux-selection = <0x03>;
						schematic-name = "S3M_VDD_CPUCL2";
						subsys-name = "CPU(BIG)";
						buck_rail;
						channel-en-byte-offset = <0x00>;
						channel-en-index = <0x04>;
