						regulator-always-on;
						regulator-initial-mode = <0x01>;
						channel-mux-selection = <0x2b>;
						schematic-name = "L11M_VDD_CPUCL2_HS_M";
						subsys-name = "CPU(BIG)";
					};

					LDO12M {
						regulator-name = "S2MPG14_LDO12";
						regulator-min-microvolt = <0xaae60>;
						regulator-max-microvolt = <0x13d620>;
						regulator-initial-mode = <0x01>;
						channel-mux-selection = <0x2c>;
						schematic-name = "L12M_VDD_CPUCL0_M";
						subsys-name = "CPU(LITTLE)";
						regulator-always-on;
					};

					LDO13M {
						regulator-name = "S2MPG14_LDO13";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0xe7ef0>;
