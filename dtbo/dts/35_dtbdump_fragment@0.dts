						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0xe7ef0>;
						regulator-initial-mode = <0x03>;
						channel-mux-selection = <0x28>;
						schematic-name = "L8M_USB";
						subsys-name = "USB";
						phandle = <0x0b>;
					};

					LDO9M {
						regulator-name = "S2MPG14_LDO9";
						regulator-min-microvolt = <0xb1008>;
						regulator-max-microvolt = <0x13d620>;
						regulator-initial-mode = <0x03>;
						channel-mux-selection = <0x29>;
						schematic-name = "L9M_USB";
						subsys-name = "USB";
						phandle = <0x0c>;
					};

					LDO10M {
						regulator-name = "S2MPG14_LDO10";
						regulator-min-microvolt = <0xb1008>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
