						regulator-min-microvolt = <0x2f4d60>;
						regulator-max-microvolt = <0x2f4d60>;
						regulator-initial-mode = <0x03>;
						channel-mux-selection = <0x2e>;
						schematic-name = "L14M_DISP_VCI";
						subsys-name = "Display";
						phandle = <0x8e>;
					};

					LDO15M {
						regulator-name = "S2MPG14_LDO15";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0xe7ef0>;
						regulator-initial-mode = <0x00>;
						channel-mux-selection = <0x2f>;
						schematic-name = "L15M_SPARE";
						subsys-name = "Spare";
					};

